# FastSpring dashboard -> Integrations -> API Credentials
# Use the credentials for the store this session-service host belongs to.
FASTSPRING_USERNAME=
FASTSPRING_PASSWORD=

# Production/standard sandbox stores use https://api.fastspring.com.
# Internal QA environments have their own API host - e.g. QA0 is
# https://qa0-api.fastspring.com (matches env: "qa0" in the SDK init and
# a storefront domain like thoran.test.qa.onfastspring.com).
FASTSPRING_API_BASE=https://qa0-api.fastspring.com

# FastSpring dashboard -> Developer Tools -> Webhooks -> your webhook ->
# HMAC SHA256 Secret. Used to verify the X-FS-Signature header on
# incoming POSTs to /webhooks.
FASTSPRING_WEBHOOK_SECRET=

PORT=3000
